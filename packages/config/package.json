{
  "name": "@4basearch/config",
  "version": "0.1.4",
  "description": "MonoRepo Shared configuration",
  "license": "MIT",
  "author": "@igorfoliver",
  "repository": {
    "type": "git",
    "url": "https://github.com/IgorFOliver/arch.git",
    "directory": "packages/config"
  },
  "keywords": [
    "config",
    "typescript",
    "jest"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./typescript": "./dist/tsconfig.json",
    "./jest": {
      "types": "./dist/jest.config.d.ts",
      "import": "./dist/jest.config.mjs",
      "require": "./dist/jest.config.js"
    }
  },
  "devDependencies": {
    "jest": "catalog:",
    "tsup": "8.5.0"
  }
}
